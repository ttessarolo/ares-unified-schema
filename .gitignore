!/outputs/schemas/
!/outputs/opensearch/
!/outputs/contracts/
!/outputs/figures/
!/outputs/verification.json
!/outputs/manifest.json
/scripts/*
!/scripts/dach_delivery/
**/__pycache__/
**/.DS_Store
**/.env
**/.env.*
