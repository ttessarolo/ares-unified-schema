                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "cts_tags_value": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "age_ratings_min_age": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "integer"
