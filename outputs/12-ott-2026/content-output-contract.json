      "description": "UMAS-side contribution used by the candidate Merge configuration."
    },
    "brand_names": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "broadcast_date_joyn",
    "broadcast_date_joyn_at",
    "broadcast_date_joyn_ch",
    "active_distribution_tenants",
    "active_distribution_models",
    "active_access_rules",
    "active_brand_codes",
    "fingerprint_super"
  ],
  "additionalProperties": false
}
